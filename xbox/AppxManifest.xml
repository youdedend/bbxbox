<!--
  bbxbox, Xbox Series X|S Retail Developer Mode, Game mode.

  Capabilities are the minimum the port needs and nothing else:

    codeGeneration    the guest is emitted and patched at run time (bbhost is a
                      HLE, not an interpreter), and the D3D12 swapchain requires
                      it anyway;
    removableStorage  the dump is on a USB drive, picked once and remembered in
                      the FutureAccessList.

  Deliberately absent: runFullTrust (not available to a Store-style app and not
  needed), broadFileSystemAccess (the dump is reached through the picker's
  grant), internetClient, microphone, webcam (SDL3's WASAPI capture is unused),
  and any background task. `TargetDeviceFamily` is Windows.Desktop because
  Developer Mode on Xbox presents as that family with the Xbox device in
  `System.DeviceModel`.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap uap2 rescap mp">

  <Identity Name="bbxbox.Bloodborne"
            Publisher="CN=bbxbox"
            Version="0.1.0.0"
            ProcessorArchitecture="x64" />

  <!-- Required by the schema for the Windows.Universal family, which is what the
       console's app model is. -->
  <mp:PhoneIdentity PhoneProductId="6f1c2a10-58b4-4e0f-9a63-2b7f0c94e11d"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>bbxbox</DisplayName>
    <PublisherDisplayName>bbxbox</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Bloodborne v1.09 native x86-64 compatibility layer with a Direct3D 12 renderer.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Store CRT framework package. bbxbox.exe links the app-local CRT
         (vcruntime140_app.dll and friends), and a sideloaded package on a console
         gets those from this framework package: the Xbox Device Portal refuses an
         upload that does not carry it in Dependencies/. package.ps1 copies
         Microsoft.VCLibs.x64.14.00.appx next to the .appx for exactly this. The
         publisher string is Microsoft's own and is compared literally. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint: the schema requires one whenever Executable* is given, and a
         packaged launch activates that name through the EXE's exported
         DllGetActivationFactory (bbxbox.def -> WINRT_GetActivationFactory in
         main.cpp), which returns bbxbox.App as the IFrameworkViewSource. -->
    <Application Id="App" Executable="bbxbox.exe" EntryPoint="bbxbox.App">
      <uap:VisualElements
        DisplayName="bbxbox"
        Description="Bloodborne compatibility layer"
        BackgroundColor="#0C0E12"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="default">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0C0E12" />
      </uap:VisualElements>
      <!-- No <Extensions>: windows.gameExplorer is a uap/3 category and this
           manifest targets uap/1, so makeappx rejects it ("violates enumeration
           constraint"). Game mode on the console comes from the title being
           launched as a game, not from an extension. -->
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="codeGeneration" />
    <rescap:Capability Name="removableStorage" />
    <DeviceCapability Name="gamepad" />
  </Capabilities>

</Package>
