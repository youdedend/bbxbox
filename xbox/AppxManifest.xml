<!--
  bbxbox, Xbox Series X|S Retail Developer Mode, Game mode.

  Capabilities are the minimum the port needs and nothing else, and every one of
  them is declared in its actual Windows 10 UWP schema namespace:

    <Capability Name="codeGeneration" />
        Foundation capability (default namespace): grants VirtualProtectFromApp
        executable transitions (RX) for guest x86-64 code and patches under W^X.
        Declaring it under rescap: causes Windows/Xbox to ignore it and deny RX.
    <uap:Capability Name="removableStorage" />
        UAP capability: paired with windows.fileTypeAssociation below, allows
        reading Bloodborne dump files from USB storage via FromApp APIs and
        KnownFolders::RemovableDevices(), in addition to FutureAccessList grants.
    <rescap:Capability Name="expandedResources" />
        Restricted capability: the Xbox Dev Mode Game-mode memory grant, needed
        for the guest's 5,120 MiB budget (docs/memory-budget.md).
    <DeviceCapability Name="gamepad" />
        Controller input via Windows.Gaming.Input.

  Deliberately absent: runFullTrust (not available to a Store-style app and not
  needed), broadFileSystemAccess, internetClient, microphone, webcam (SDL3's
  WASAPI capture is unused), and any background task.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap uap2 rescap mp">

  <Identity Name="bbxbox.Bloodborne"
            Publisher="CN=bbxbox"
            Version="0.1.0.0"
            ProcessorArchitecture="x64" />

  <!-- Required by the schema for the Windows.Universal family, which is what the
       console's app model is. -->
  <mp:PhoneIdentity PhoneProductId="6f1c2a10-58b4-4e0f-9a63-2b7f0c94e11d"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Bloodborne</DisplayName>
    <PublisherDisplayName>Yharnam Workshop</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Bloodborne v1.09 native x86-64 compatibility layer with a Direct3D 12 renderer for Xbox Series X|S.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- The Store CRT framework package. bbxbox.exe links the app-local CRT
         (vcruntime140_app.dll and friends), and a sideloaded package on a console
         gets those from this framework package: the Xbox Device Portal refuses an
         upload that does not carry it in Dependencies/. package.ps1 copies
         Microsoft.VCLibs.x64.14.00.appx next to the .appx for exactly this. The
         publisher string is Microsoft's own and is compared literally. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00"
      MinVersion="14.0.30704.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint: the schema requires one whenever Executable* is given, and a
         packaged launch activates that name through the EXE's exported
         DllGetActivationFactory (bbxbox.def -> WINRT_GetActivationFactory in
         main.cpp), which returns bbxbox.App as the IFrameworkViewSource. -->
    <Application Id="App" Executable="bbxbox.exe" EntryPoint="bbxbox.App">
      <uap:VisualElements
        DisplayName="Bloodborne"
        Description="Bloodborne — Seek Paleblood to transcend the hunt"
        BackgroundColor="#09060A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="default">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#09060A" />
      </uap:VisualElements>
      <!-- UWP's removableStorage capability only exposes files on USB drives
           whose extensions are registered in a windows.fileTypeAssociation
           extension. Declaring Bloodborne's dump, patch, mod and baked-cache
           extensions here enables direct FromApp and RemovableDevices reads. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="bbxboxassets">
            <uap:DisplayName>Bloodborne game dump</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.bin</uap:FileType>
              <uap:FileType>.sfo</uap:FileType>
              <uap:FileType>.prx</uap:FileType>
              <uap:FileType>.sprx</uap:FileType>
              <uap:FileType>.self</uap:FileType>
              <uap:FileType>.elf</uap:FileType>
              <uap:FileType>.dcx</uap:FileType>
              <uap:FileType>.bnd</uap:FileType>
              <uap:FileType>.bhd</uap:FileType>
              <uap:FileType>.bhd5</uap:FileType>
              <uap:FileType>.bdt</uap:FileType>
              <uap:FileType>.tpf</uap:FileType>
              <uap:FileType>.tpfbhd</uap:FileType>
              <uap:FileType>.tpfbdt</uap:FileType>
              <uap:FileType>.cache</uap:FileType>
              <uap:FileType>.paths</uap:FileType>
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.ini</uap:FileType>
              <uap:FileType>.log</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.fsb</uap:FileType>
              <uap:FileType>.fev</uap:FileType>
              <uap:FileType>.bnk</uap:FileType>
              <uap:FileType>.at9</uap:FileType>
              <uap:FileType>.wem</uap:FileType>
              <uap:FileType>.pck</uap:FileType>
              <uap:FileType>.dat</uap:FileType>
              <uap:FileType>.dds</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.trp</uap:FileType>
              <uap:FileType>.json</uap:FileType>
              <uap:FileType>.xml</uap:FileType>
              <uap:FileType>.cfg</uap:FileType>
              <uap:FileType>.lua</uap:FileType>
              <uap:FileType>.sav</uap:FileType>
              <uap:FileType>.sl2</uap:FileType>
              <uap:FileType>.msb</uap:FileType>
              <uap:FileType>.flver</uap:FileType>
              <uap:FileType>.hkx</uap:FileType>
              <uap:FileType>.fmg</uap:FileType>
              <uap:FileType>.mtd</uap:FileType>
              <uap:FileType>.evd</uap:FileType>
              <uap:FileType>.emevd</uap:FileType>
              <uap:FileType>.gparam</uap:FileType>
              <uap:FileType>.btl</uap:FileType>
              <uap:FileType>.tae</uap:FileType>
              <uap:FileType>.drb</uap:FileType>
              <uap:FileType>.ccm</uap:FileType>
              <uap:FileType>.fnt</uap:FileType>
              <uap:FileType>.tdf</uap:FileType>
              <uap:FileType>.ver</uap:FileType>
              <uap:FileType>.info</uap:FileType>
              <uap:FileType>.sha</uap:FileType>
              <uap:FileType>.sig</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- URI protocol activation (`bbxbox:?cmd=...&launchOnExit=...`) so Xbox
             Dev Mode frontends such as LaunchPass and RetroPass can launch
             Bloodborne directly and resume cleanly on exit. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="bbxbox" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Foundation capability (default namespace): grants W^X RX transitions
         via VirtualProtectFromApp on Xbox Series X|S Dev Mode. -->
    <Capability Name="codeGeneration" />
    <!-- UAP capability: grants removable USB storage access for the file types
         declared in windows.fileTypeAssociation above. -->
    <uap:Capability Name="removableStorage" />
    <!-- Game mode's memory grant. A title without it is capped at the
         shared-memory limit and the guest's budget cannot be met
         (docs/memory-budget.md). -->
    <rescap:Capability Name="expandedResources" />
    <DeviceCapability Name="gamepad" />
  </Capabilities>

</Package>
