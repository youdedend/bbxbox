# SPDX-License-Identifier: GPL-3.0-or-later
# Turns the compiled DXIL blobs into a header of constexpr byte arrays.
#
# Called by xbox/CMakeLists.txt once, after dxc has produced every .dxil:
#   cmake -DOUT=... -DPAIRS_FILE=...pairs.txt -P embed_shaders.cmake
# (pairs.txt holds one "PresentVs=/path/PresentVs.dxil" per line)
#
# A header rather than a file loaded at run time because these shaders are part
# of the executable: the console app has no runtime shader compiler (see task
# "no dxcompiler.dll on the console"), so the bytes are the program.
if(NOT OUT)
    message(FATAL_ERROR "embed_shaders.cmake needs -DOUT=<header path>")
endif()
if(NOT PAIRS_FILE)
    message(FATAL_ERROR "embed_shaders.cmake needs -DPAIRS_FILE=<file of symbol=path lines>")
endif()
if(NOT EXISTS "${PAIRS_FILE}")
    message(FATAL_ERROR "embed_shaders.cmake: ${PAIRS_FILE} does not exist")
endif()
# One "symbol=path" per line, written by xbox/CMakeLists.txt at configure time.
file(STRINGS "${PAIRS_FILE}" pairs)

set(content "// SPDX-License-Identifier: GPL-3.0-or-later\n")
string(APPEND content "// Generated by cmake/embed_shaders.cmake from xbox/shaders/*.hlsl.\n")
string(APPEND content "// Do not edit: change the .hlsl and rebuild.\n")
string(APPEND content "#pragma once\n\n")
string(APPEND content "#include <cstddef>\n\n")
string(APPEND content "namespace bbx::shaders::generated {\n")

foreach(pair IN LISTS pairs)
    if(pair STREQUAL "")
        continue()
    endif()
    string(FIND "${pair}" "=" eq)
    if(eq EQUAL -1)
        message(FATAL_ERROR "embed_shaders.cmake: '${pair}' is not <symbol>=<file>")
    endif()
    string(SUBSTRING "${pair}" 0 ${eq} symbol)
    math(EXPR first "${eq} + 1")
    string(SUBSTRING "${pair}" ${first} -1 path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "embed_shaders.cmake: ${path} does not exist (from '${pair}')")
    endif()
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    if(size EQUAL 0)
        message(FATAL_ERROR "embed_shaders.cmake: ${path} is empty")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
    string(APPEND content "\n// ${path} (${size} bytes of signed DXIL)\n")
    string(APPEND content "inline constexpr unsigned char k${symbol}[] = {${bytes}};\n")
    string(APPEND content "inline constexpr std::size_t k${symbol}Size = ${size};\n")
    message(STATUS "embed_shaders: ${symbol} <- ${path} (${size} bytes)")
endforeach()

string(APPEND content "\n}  // namespace bbx::shaders::generated\n")

# Only rewrite when the bytes changed: a rebuild that touches this header
# recompiles every translation unit that includes it.
set(needs_write TRUE)
if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
    if(existing STREQUAL content)
        set(needs_write FALSE)
    endif()
endif()
if(needs_write)
    file(WRITE "${OUT}" "${content}")
endif()
